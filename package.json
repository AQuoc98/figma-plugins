{
  "name": "figma-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:ui": "vite build",
    "build:code": "vite build --config vite.config.code.ts",
    "build": "npm run build:ui && npm run build:code",
    "watch:ui": "vite build --watch",
    "watch:code": "vite build --config vite.config.code.ts --watch",
    "watch": "npm-run-all --parallel watch:ui watch:code",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.108.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
